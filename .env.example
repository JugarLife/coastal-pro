# ── Enquiry delivery ─────────────────────────────────────────
# Until these are set, /api/enquiry validates and LOGS ONLY.
# It returns delivered:false — enquiries reach nobody.
RESEND_API_KEY=
ENQUIRY_TO=            # a mailbox you can actually READ (Resend sends, it cannot receive)
ENQUIRY_FROM="Coastal Pro Property Care <enquiries@coastalpropropertycare.com>"

# ── Stripe ───────────────────────────────────────────────────
# Absent these, payment routes return 503 and the site runs
# enquiry-only. Nothing breaks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One Product per tier, each with a monthly and an annual Price.
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_ANNUAL=
STRIPE_PRICE_SIGNATURE_MONTHLY=
STRIPE_PRICE_SIGNATURE_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=

# Counted against live subscriptions, never hardcoded.
PREMIUM_CAP=5

NEXT_PUBLIC_SITE_URL=https://coastalpropropertycare.com
